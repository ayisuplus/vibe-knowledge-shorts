[
 {
  "seg": "S1",
  "text": "我把大模型家族，做成了星星。",
  "pic": "Fable 浮雕极近特写：龟兔赛跑的浮雕从暗处被光扫亮",
  "start": 1.4,
  "end": 4.32,
  "dur": 2.92,
  "measured": true,
  "tag": "",
  "cap_end": 4.4
 },
 {
  "seg": "S1",
  "text": "每一颗星，是一个模型；",
  "pic": "急速拉远：Fable 缩成一颗星，周围一颗颗星亮起",
  "start": 4.92,
  "end": 7.4,
  "dur": 2.48,
  "measured": true,
  "tag": "",
  "cap_end": 7.4
 },
 {
  "seg": "S1",
  "text": "每一片星云，是一个家族。",
  "pic": "继续拉远：星点聚成十几片不同颜色的星云，全景",
  "start": 7.65,
  "end": 10.21,
  "dur": 2.56,
  "measured": true,
  "tag": "",
  "cap_end": 10.21
 },
 {
  "seg": "S1",
  "text": "你每天聊天的那个 AI，也住在这里面。",
  "pic": "全景缓慢旋转，星云间有细光丝相连",
  "start": 10.81,
  "end": 14.07,
  "dur": 3.26,
  "measured": true,
  "tag": "",
  "cap_end": 14.59
 },
 {
  "seg": "S1",
  "text": "我们去找找它。",
  "pic": "镜头开始向宇宙中心前进",
  "start": 14.67,
  "end": 15.67,
  "dur": 1.0,
  "measured": true,
  "tag": "",
  "cap_end": 16.17
 },
 {
  "seg": "S2",
  "text": "一切，从 2017 年的一篇论文开始。",
  "pic": "飞向中心：一个孤零零的白色亮点",
  "start": 17.37,
  "end": 20.77,
  "dur": 3.4,
  "measured": true,
  "tag": "",
  "cap_end": 20.87
 },
 {
  "seg": "S2",
  "text": "它提出了 Transformer。",
  "pic": "亮点压缩、发白",
  "start": 21.17,
  "end": 23.59,
  "dur": 2.42,
  "measured": true,
  "tag": "",
  "cap_end": 23.59
 },
 {
  "seg": "S2",
  "text": "宇宙，从这里炸开。",
  "pic": "大爆炸：光环向外扩散",
  "start": 23.79,
  "end": 25.83,
  "dur": 2.04,
  "measured": true,
  "tag": "",
  "cap_end": 25.83
 },
 {
  "seg": "S2",
  "text": "论文的八位作者，后来全都离开了谷歌。",
  "pic": "八道光流从爆炸点射向四面八方",
  "start": 26.73,
  "end": 30.23,
  "dur": 3.5,
  "measured": true,
  "tag": "",
  "cap_end": 30.45
 },
 {
  "seg": "S2",
  "text": "星星，散到了各家。",
  "pic": "光流落点各自凝成星云；一侧掠过一小簇彩色的「芝麻街星团」",
  "start": 30.53,
  "end": 32.85,
  "dur": 2.32,
  "measured": true,
  "tag": "",
  "cap_end": 32.85
 },
 {
  "seg": "S3",
  "text": "每颗星的样子，都藏在名字里。",
  "pic": "镜头转向第一片星云",
  "start": 34.55,
  "end": 37.43,
  "dur": 2.88,
  "measured": true,
  "tag": "",
  "cap_end": 37.55
 },
 {
  "seg": "S3",
  "text": "Gemini 是双子座：",
  "pic": "蓝、暖两颗气态星互相绕转；名字浮现「Gemini · 双子座」",
  "start": 38.03,
  "end": 40.03,
  "dur": 2.0,
  "measured": true,
  "tag": "",
  "cap_end": 40.03
 },
 {
  "seg": "S3",
  "text": "两个团队，合成了一个。",
  "pic": "双星靠近、并排；Gemma 宝石卫星闪光",
  "start": 40.23,
  "end": 42.57,
  "dur": 2.34,
  "measured": true,
  "tag": "",
  "cap_end": 42.57
 },
 {
  "seg": "S3",
  "text": "Claude 的三档，按诗的长短排：",
  "pic": "掠过三颗由小到大的星",
  "start": 43.37,
  "end": 46.25,
  "dur": 2.88,
  "measured": true,
  "tag": "",
  "cap_end": 46.25
 },
 {
  "seg": "S3",
  "text": "俳句，十四行诗，长篇。",
  "pic": "依次掠过 Haiku（3 条带）/ Sonnet（14 条带）/ Opus（华丽纹带）",
  "start": 46.45,
  "end": 49.41,
  "dur": 2.96,
  "measured": true,
  "tag": "",
  "cap_end": 49.41
 },
 {
  "seg": "S3",
  "text": "它最强的叫 Mythos，神话；",
  "pic": "镜头靠近一颗被深色面纱裹住的星，面纱孔洞里透出金色神话浮雕",
  "start": 50.11,
  "end": 53.21,
  "dur": 3.1,
  "measured": true,
  "tag": "",
  "cap_end": 53.21
 },
 {
  "seg": "S3",
  "text": "公开的那个，叫 Fable，寓言。",
  "pic": "镜头拉开：Fable 在 Mythos 旁边，同样的浮雕、没有面纱（回到开场那颗星）",
  "start": 53.46,
  "end": 57.42,
  "dur": 3.96,
  "measured": true,
  "tag": "",
  "cap_end": 57.42
 },
 {
  "seg": "S3",
  "text": "而月之暗面的 Kimi，永远只亮着半边。",
  "pic": "白色月亮，镜头从亮面绕向暗面，暗面亮起流动的细光",
  "start": 58.22,
  "end": 62.22,
  "dur": 4.0,
  "measured": true,
  "tag": "",
  "cap_end": 62.22
 },
 {
  "seg": "S4",
  "text": "可是，你发现了吗？",
  "pic": "镜头急退，拉到能同时看见几片星云的远景",
  "start": 64.22,
  "end": 66.02,
  "dur": 1.8,
  "measured": true,
  "tag": "",
  "cap_end": 66.02
 },
 {
  "seg": "S4",
  "text": "最有名的那几片星云，周围是空的。",
  "pic": "闭源星云（GPT / Claude / Gemini 主线）四周干净，只有恒星",
  "start": 66.32,
  "end": 69.84,
  "dur": 3.52,
  "measured": true,
  "tag": "",
  "cap_end": 69.84
 },
 {
  "seg": "S4",
  "text": "真正热闹的，是千问和 Llama。",
  "pic": "镜头转向两片被浓密星尘包裹的星云：青花瓷千问、织锦 Llama",
  "start": 70.44,
  "end": 73.72,
  "dur": 3.28,
  "measured": true,
  "tag": "",
  "cap_end": 73.72
 },
 {
  "seg": "S4",
  "text": "它们把模型公开，",
  "pic": "星尘从两颗星上涌出",
  "start": 73.97,
  "end": 75.73,
  "dur": 1.76,
  "measured": true,
  "tag": "",
  "cap_end": 75.73
 },
 {
  "seg": "S4",
  "text": "全世界的人改出了上万个新模型，像星尘。",
  "pic": "星尘铺满画面（粒子，不是小图标）；DeepSeek 的光丝穿进千问和 Llama 的星尘",
  "start": 75.88,
  "end": 80.24,
  "dur": 4.36,
  "measured": true,
  "tag": "",
  "cap_end": 80.24
 },
 {
  "seg": "S4",
  "text": "后来，Meta 换上了不公开的新模型。",
  "pic": "Llama 星旁亮起一颗不透明的新星（Muse Spark）",
  "start": 80.84,
  "end": 84.36,
  "dur": 3.52,
  "measured": true,
  "tag": "",
  "cap_end": 84.36
 },
 {
  "seg": "S4",
  "text": "此后 Llama 没有再诞生新星，",
  "pic": "Llama 星云的核心慢慢暗下去",
  "start": 84.61,
  "end": 88.09,
  "dur": 3.48,
  "measured": true,
  "tag": "",
  "cap_end": 88.09
 },
 {
  "seg": "S4",
  "text": "可它的星尘，还在扩散。",
  "pic": "暗下去的核心周围，星尘继续向外飘",
  "start": 88.24,
  "end": 90.96,
  "dur": 2.72,
  "measured": true,
  "tag": "",
  "cap_end": 90.96
 },
 {
  "seg": "S5",
  "text": "OpenAI 把型号叫成了月亮、太阳和群星。",
  "pic": "日地月系统：从 Luna 特写拉开，掠过 Terra",
  "start": 92.86,
  "end": 98.78,
  "dur": 5.92,
  "measured": true,
  "tag": "",
  "cap_end": 98.78
 },
 {
  "seg": "S5",
  "text": "越强的，离我们越远。",
  "pic": "绕到 Terra 背后，「日出」；飞向 Sol，再抬头看见 Astra 星簇",
  "start": 99.08,
  "end": 101.3,
  "dur": 2.22,
  "measured": true,
  "tag": "",
  "cap_end": 101.3
 },
 {
  "seg": "S5",
  "text": "你每天聊天的那颗星，就在这些光里。",
  "pic": "Astra 星簇居中，镜头继续上升，整片宇宙重新进入画面",
  "start": 102.1,
  "end": 105.04,
  "dur": 2.94,
  "measured": true,
  "tag": "",
  "cap_end": 105.85
 },
 {
  "seg": "S6",
  "text": "截至 2026 年 10 月，",
  "pic": "全景；宇宙边缘一颗新星亮起",
  "start": 106.84,
  "end": 109.38,
  "dur": 2.54,
  "measured": true,
  "tag": "",
  "cap_end": 109.38
 },
 {
  "seg": "S6",
  "text": "这片宇宙还在不断点亮新的星星。",
  "pic": "边缘接连亮起更多新星，镜头加速向外",
  "start": 109.53,
  "end": 112.73,
  "dur": 3.2,
  "measured": true,
  "tag": "",
  "cap_end": 113.03
 },
 {
  "seg": "S6",
  "text": "下一颗被点亮的星，会是谁做的？",
  "pic": "问句由画面中央大字呈现；最后半拍硬切黑",
  "start": 113.53,
  "end": 116.41,
  "dur": 2.88,
  "measured": true,
  "tag": "noshow",
  "cap_end": 116.78
 }
]